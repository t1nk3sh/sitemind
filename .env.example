# --- Multimodal Construction Intelligence Platform ---
# Live multimodal AI. Leave blank to run the deterministic demo engine.
# Get a key at https://aistudio.google.com/apikey (free tier available).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Storage
DATA_DIR=./data
MAX_UPLOAD_MB=8

# Optional: fail requests instead of using the demo engine when no key is set.
REQUIRE_LIVE_AI=false
