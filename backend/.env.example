# Local development settings. Never commit real credentials here.
# For deployment, set these on the service's Environment tab (Render) or
# via your host's secret store — not in a checked-in .env.

# Live model: your Gemini API key (get one at
# https://aistudio.google.com/apikey). Leave empty or unset for demo mode.
GEMINI_API_KEY=

# Optional: the multimodal model to call. Accounts vary in which versions
# they expose, so keep this configurable.
# GEMINI_MODEL=gemini-3.8-flash

# Storage root (SQLite database + uploaded site photos). Keep this on a
# persistent disk in production.
# DATA_DIR=./data

# Allowed CORS origins (comma-separated). "*" is fine when the frontend and
# API share one host; otherwise set the deploy origin.
# CORS_ORIGINS=http://localhost:3000

# Upload size limit in MB.
# MAX_UPLOAD_MB=8

# Timeout for the model provider call, in seconds.
# AI_TIMEOUT_SECONDS=120

# Set to "true" to hard-fail when no API key is configured, instead of
# running the demo engine.
# REQUIRE_LIVE_AI=false
